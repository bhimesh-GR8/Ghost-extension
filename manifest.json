{
  "manifest_version": 3,
  "name": "ghost extension",
  "version": "1.0.0",
  "description": "A spooky extension to make your chrome experience spookier",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
    },
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}