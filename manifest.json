{
  "manifest_version": 3,
  "name": "ghost extension",
  "version": "1.0.0",
  "description": "A spooky extension to make your chrome experience spookier",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["jumpscare.js"],
      "css": ["jumpscare.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/i16.jpg",
    "48": "icons/i48.jpg",
    "128": "icons/i128.jpg"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "action": {
    "default_icon": {
      "16": "icons/i16.jpg",
      "48": "icons/i48.jpg",
      "128": "icons/i128.jpg"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["https://www.youtube.com/*"]
    },
    {
      "resources": ["images/scare.jpg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}