{
  "manifest_version": 3,
  "name": "ghost extension",
  "version": "1.0.0",
  "description": "A spooky extension to make your chrome experience spookier",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube/content.js"],
      "css": ["youtube/style.css"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
          "allsites/skip.js",
          "allsites/jumpscare.js",  
          "allsites/ghost.js",
          "allsites/trail.js"],
      "css": ["allsites/jumpscare.css", "allsites/ghost.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/i16.png",
    "48": "icons/i48.png",
    "128": "icons/i128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "activeTab"
  ],
  "action": {
    "default_icon": {
      "16": "icons/i16.png",
      "48": "icons/i48.png",
      "128": "icons/i128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["https://www.youtube.com/*"]
    },
    {
      "resources": ["images/scare1.jpg", "images/ghost.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}